<section class="features-section">
    <div class="container">
        <div class="section-header">
            <span class="section-badge">Features</span>
            <h2 class="section-title">Everything You Need</h2>
            <p class="section-subtitle">Powerful tools designed for modern educational institutions</p>
        </div>
        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon primary">
                    <i class="bi bi-qr-code"></i>
                </div>
                <h5>QR Code Generation</h5>
                <p>Unique, encrypted QR codes generated for each student per examination. Tamper-proof and time-limited for maximum security.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon accent">
                    <i class="bi bi-camera"></i>
                </div>
                <h5>Real-time Scanning</h5>
                <p>Lecturers scan student QR codes instantly using any device camera. Immediate verification with student photo display.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon success">
                    <i class="bi bi-shield-lock"></i>
                </div>
                <h5>Anti-Impersonation</h5>
                <p>Advanced fraud detection rejects duplicate scans, expired codes, and logs all suspicious activity automatically.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon primary">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
                <h5>Reports & Analytics</h5>
                <p>Comprehensive attendance reports with export to PDF and Excel. Track trends, identify absent students, and generate summaries.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon accent">
                    <i class="bi bi-people"></i>
                </div>
                <h5>Role-Based Access</h5>
                <p>Dedicated dashboards for students, lecturers, and administrators. Each role sees only what they need.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon success">
                    <i class="bi bi-phone"></i>
                </div>
                <h5>Mobile Responsive</h5>
                <p>Fully responsive design works on any device — desktop, tablet, or smartphone. Scan and manage attendance on the go.</p>
            </div>
        </div>
    </div>
</section>

<section class="how-it-works-section">
    <div class="container">
        <div class="section-header">
            <span class="section-badge" style="background-color: var(--color-primary-light); color: var(--color-primary);">How It Works</span>
            <h2 class="section-title">Simple 3-Step Process</h2>
            <p class="section-subtitle">Getting started is quick and easy</p>
        </div>
        <div class="steps-container">
            <div class="step-card">
                <div class="step-number">1</div>
                <h5>Generate QR Code</h5>
                <p>Admin creates examinations and the system generates unique QR codes for each eligible student.</p>
            </div>
            <div class="step-card">
                <div class="step-number">2</div>
                <h5>Scan at Exam</h5>
                <p>Lecturer opens the scanner, scans the student's QR code, and the system verifies identity in real-time.</p>
            </div>
            <div class="step-card">
                <div class="step-number">3</div>
                <h5>Attendance Recorded</h5>
                <p>Attendance is automatically recorded with timestamp. Reports are available instantly for review.</p>
            </div>
        </div>
    </div>
</section>

<section class="cta-section">
    <div class="container">
        <h2>Ready to Modernize Your Attendance System?</h2>
        <p>Join institutions using QR technology for secure exam attendance management.</p>
        <a href="/auth/register" class="btn-cta">
            <i class="bi bi-rocket-takeoff"></i> Get Started Free
        </a>
    </div>
</section>
