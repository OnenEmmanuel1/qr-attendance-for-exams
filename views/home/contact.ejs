<!-- Contact Page -->
<link rel="stylesheet" href="/css/pages/contact.css">
<section class="contact-hero">
    <div class="container">
        <h1>Contact Us</h1>
        <p>Have questions or need support? We're here to help.</p>
    </div>
</section>

<section class="contact-content">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-7">
                <div class="contact-form-card">
                    <h3>Send Us a Message</h3>
                    <form action="/contact" method="POST" id="contactForm">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-group-custom">
                                    <label for="contactName">Full Name <span class="required-mark">*</span></label>
                                    <input type="text" id="contactName" name="name" class="form-control-custom" placeholder="Enter your full name" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group-custom">
                                    <label for="contactEmail">Email Address <span class="required-mark">*</span></label>
                                    <input type="email" id="contactEmail" name="email" class="form-control-custom" placeholder="Enter your email" required>
                                </div>
                            </div>
                        </div>
                        <div class="form-group-custom">
                            <label for="contactSubject">Subject <span class="required-mark">*</span></label>
                            <input type="text" id="contactSubject" name="subject" class="form-control-custom" placeholder="What is this about?" required>
                        </div>
                        <div class="form-group-custom">
                            <label for="contactMessage">Message <span class="required-mark">*</span></label>
                            <textarea id="contactMessage" name="message" class="form-textarea-custom" rows="5" placeholder="Type your message here..." required></textarea>
                        </div>
                        <button type="submit" class="btn-custom btn-primary-custom">
                            <i class="bi bi-send"></i> Send Message
                        </button>
                    </form>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="contact-info-card">
                    <h3>Contact Information</h3>
                    <div class="contact-info-item">
                        <div class="info-icon">
                            <i class="bi bi-geo-alt"></i>
                        </div>
                        <div>
                            <h6>Address</h6>
                            <p>University of Cross River State<br>Calabar, Nigeria</p>
                        </div>
                    </div>
                    <div class="contact-info-item">
                        <div class="info-icon">
                            <i class="bi bi-envelope"></i>
                        </div>
                        <div>
                            <h6>Email</h6>
                            <p>support@qrexam.edu.ng</p>
                        </div>
                    </div>
                    <div class="contact-info-item">
                        <div class="info-icon">
                            <i class="bi bi-telephone"></i>
                        </div>
                        <div>
                            <h6>Phone</h6>
                            <p>+234 800 000 0000</p>
                        </div>
                    </div>
                    <div class="contact-info-item">
                        <div class="info-icon">
                            <i class="bi bi-clock"></i>
                        </div>
                        <div>
                            <h6>Working Hours</h6>
                            <p>Mon - Fri: 8:00 AM - 5:00 PM</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
