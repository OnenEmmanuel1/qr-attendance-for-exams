<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="QR Code-Based Examination Attendance Management System - Secure, fast, and reliable attendance tracking">
    <title><%= typeof title !== 'undefined' ? title + ' | ' : '' %><%= appName %></title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/variables.css">
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/footer.css">
    <link rel="stylesheet" href="/css/components/buttons.css">
    <link rel="stylesheet" href="/css/components/cards.css">
    <link rel="stylesheet" href="/css/components/forms.css">
    <link rel="stylesheet" href="/css/components/tables.css">
    <link rel="stylesheet" href="/css/components/modals.css">
    <% if (typeof layout_type !== 'undefined' && layout_type === 'dashboard') { %>
        <link rel="stylesheet" href="/css/pages/dashboard.css">
    <% } %>

    <!-- Page-specific CSS -->
    <% if (typeof pageCSS !== 'undefined' && pageCSS) { %>
        <% if (Array.isArray(pageCSS)) { %>
            <% pageCSS.forEach(function(css) { %>
                <link rel="stylesheet" href="/css/<%= css %>">
            <% }); %>
        <% } else { %>
            <link rel="stylesheet" href="/css/<%= pageCSS %>">
        <% } %>
    <% } %>
</head>
<body class="<%= user ? 'logged-in' : 'guest' %>">
    <!-- Flash Messages -->
    <%- include('../partials/flash') %>

    <!-- Navbar / Sidebar -->
    <% if (typeof layout_type !== 'undefined' && layout_type === 'dashboard') { %>
        <!-- Dashboard Layout with Sidebar -->
        <div class="dashboard-layout">
            <%- include('../partials/sidebar') %>
            <div class="dashboard-main">
                <%- include('../partials/dashboard-topbar') %>
                <div class="dashboard-content">
                    <%- body %>
                </div>
                <footer class="dashboard-footer">
                    &copy; <%= new Date().getFullYear() %> <%= appName %>. All rights reserved.
                </footer>
            </div>
        </div>
        <div class="sidebar-overlay" id="sidebarOverlay"></div>
    <% } else { %>
        <!-- Public Layout with Navbar -->
        <%- include('../partials/navbar') %>
        <main class="main-content">
            <%- body %>
        </main>
        <% if (typeof hideFooter === 'undefined' || !hideFooter) { %>
            <%- include('../partials/footer') %>
        <% } %>
    <% } %>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Global JS -->
    <script src="/js/main.js"></script>

    <!-- Page-specific JS -->
    <% if (typeof pageJS !== 'undefined' && pageJS) { %>
        <% if (Array.isArray(pageJS)) { %>
            <% pageJS.forEach(function(js) { %>
                <script src="/js/<%= js %>"></script>
            <% }); %>
        <% } else { %>
            <script src="/js/<%= pageJS %>"></script>
        <% } %>
    <% } %>

    <!-- Inline Scripts -->
    <% if (typeof inlineScript !== 'undefined' && inlineScript) { %>
        <script><%- inlineScript %></script>
    <% } %>
</body>
</html>
