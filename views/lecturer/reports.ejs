<!-- Lecturer Reports -->
<link rel="stylesheet" href="/css/pages/reports.css">
<div class="report-filters">
    <h5><i class="bi bi-funnel me-2"></i>Generate Report</h5>
    <form id="reportFilterForm" class="report-filter-grid">
        <div class="form-group-custom">
            <label for="reportExam">Examination</label>
            <select id="reportExam" name="examination_id" class="form-select-custom">
                <option value="">Select Examination</option>
                <% if (typeof examinations !== 'undefined') { %>
                    <% examinations.forEach(function(exam) { %>
                        <option value="<%= exam.id %>"><%= exam.course_code %> - <%= exam.exam_date %></option>
                    <% }); %>
                <% } %>
            </select>
        </div>
        <div class="form-group-custom">
            <label for="reportDateFrom">From Date</label>
            <input type="date" id="reportDateFrom" name="date_from" class="form-control-custom">
        </div>
        <div class="form-group-custom">
            <label for="reportDateTo">To Date</label>
            <input type="date" id="reportDateTo" name="date_to" class="form-control-custom">
        </div>
        <div class="form-group-custom d-flex align-items-end">
            <button type="submit" class="btn-custom btn-primary-custom">
                <i class="bi bi-search"></i> Generate
            </button>
        </div>
    </form>
</div>

<!-- Report Summary -->
<div class="report-summary">
    <div class="report-summary-card">
        <div class="summary-value primary"><%= typeof reportData !== 'undefined' ? reportData.total || 0 : 0 %></div>
        <div class="summary-label">Total Students</div>
    </div>
    <div class="report-summary-card">
        <div class="summary-value success"><%= typeof reportData !== 'undefined' ? reportData.present || 0 : 0 %></div>
        <div class="summary-label">Present</div>
    </div>
    <div class="report-summary-card">
        <div class="summary-value danger"><%= typeof reportData !== 'undefined' ? reportData.absent || 0 : 0 %></div>
        <div class="summary-label">Absent</div>
    </div>
    <div class="report-summary-card">
        <div class="summary-value accent"><%= typeof reportData !== 'undefined' ? reportData.percentage || '0%' : '0%' %></div>
        <div class="summary-label">Attendance Rate</div>
    </div>
</div>

<!-- Export Bar -->
<div class="report-export-bar">
    <h5 style="margin:0;"><i class="bi bi-table me-2"></i>Report Details</h5>
    <div class="export-buttons">
        <a href="/lecturer/reports/export/pdf?<%= typeof query !== 'undefined' ? query : '' %>" class="btn-custom btn-sm-custom btn-danger-custom">
            <i class="bi bi-file-earmark-pdf"></i> Export PDF
        </a>
        <a href="/lecturer/reports/export/excel?<%= typeof query !== 'undefined' ? query : '' %>" class="btn-custom btn-sm-custom btn-success-custom">
            <i class="bi bi-file-earmark-excel"></i> Export Excel
        </a>
    </div>
</div>

<!-- Report Table -->
<div class="card-custom">
    <div class="table-wrapper">
        <table class="table-custom">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Student Name</th>
                    <th>Matric Number</th>
                    <th>Department</th>
                    <th>Status</th>
                    <th>Time</th>
                </tr>
            </thead>
            <tbody>
                <% if (typeof reportRecords !== 'undefined' && reportRecords.length > 0) { %>
                    <% reportRecords.forEach(function(r, i) { %>
                        <tr>
                            <td><%= i + 1 %></td>
                            <td><%= r.first_name %> <%= r.last_name %></td>
                            <td><%= r.matric_number %></td>
                            <td><%= r.department_name %></td>
                            <td><span class="status-badge <%= r.status %>"><%= r.status %></span></td>
                            <td><%= r.scanned_at || '—' %></td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="6">
                            <div class="empty-state">
                                <i class="bi bi-bar-chart-line"></i>
                                <h5>No Report Data</h5>
                                <p>Select an examination and generate a report to see data.</p>
                            </div>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>
