<!-- Reset Password Page -->
<link rel="stylesheet" href="/css/pages/login.css">
<div class="auth-page">
    <div class="auth-container">
        <div class="auth-logo">
            <div class="logo-icon">
                <i class="bi bi-shield-lock"></i>
            </div>
            <h2>Reset Password</h2>
            <p>Enter your new password below</p>
        </div>

        <div class="auth-card">
            <form action="/auth/reset-password" method="POST" id="resetPasswordForm">
                <input type="hidden" name="token" value="<%= typeof token !== 'undefined' ? token : '' %>">

                <div class="form-group-custom">
                    <label for="newPassword">New Password</label>
                    <div class="input-icon-wrapper">
                        <i class="bi bi-lock input-icon"></i>
                        <input type="password" id="newPassword" name="password" class="form-control-custom" placeholder="Enter new password (min 6 characters)" required minlength="6">
                    </div>
                </div>

                <div class="form-group-custom">
                    <label for="confirmNewPassword">Confirm New Password</label>
                    <div class="input-icon-wrapper">
                        <i class="bi bi-lock input-icon"></i>
                        <input type="password" id="confirmNewPassword" name="confirm_password" class="form-control-custom" placeholder="Confirm new password" required>
                    </div>
                </div>

                <button type="submit" class="btn-custom btn-primary-custom btn-auth">
                    <i class="bi bi-check-lg"></i> Reset Password
                </button>
            </form>
        </div>

        <div class="auth-back-link">
            <a href="/auth/login"><i class="bi bi-arrow-left"></i> Back to Login</a>
        </div>
    </div>
</div>
