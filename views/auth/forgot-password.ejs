<!-- Forgot Password Page -->
<link rel="stylesheet" href="/css/pages/login.css">
<div class="auth-page">
    <div class="auth-container">
        <div class="auth-logo">
            <div class="logo-icon">
                <i class="bi bi-key"></i>
            </div>
            <h2>Forgot Password</h2>
            <p>Enter your email to receive a password reset link</p>
        </div>

        <div class="auth-card">
            <form action="/auth/forgot-password" method="POST" id="forgotPasswordForm">
                <div class="form-group-custom">
                    <label for="resetEmail">Email Address</label>
                    <div class="input-icon-wrapper">
                        <i class="bi bi-envelope input-icon"></i>
                        <input type="email" id="resetEmail" name="email" class="form-control-custom" placeholder="Enter your registered email" required>
                    </div>
                </div>

                <button type="submit" class="btn-custom btn-primary-custom btn-auth">
                    <i class="bi bi-send"></i> Send Reset Link
                </button>
            </form>
        </div>

        <div class="auth-footer">
            Remember your password? <a href="/auth/login">Sign In</a>
        </div>

        <div class="auth-back-link">
            <a href="/"><i class="bi bi-arrow-left"></i> Back to Home</a>
        </div>
    </div>
</div>
