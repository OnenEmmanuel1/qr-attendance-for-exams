<!-- Login Page -->
<link rel="stylesheet" href="/css/pages/login.css">
<div class="auth-page">
    <div class="auth-container">
        <div class="auth-logo">
            <div class="logo-icon">
                <i class="bi bi-qr-code-scan"></i>
            </div>
            <h2>Welcome Back</h2>
            <p>Sign in to your account to continue</p>
        </div>

        <div class="auth-card">
            <form action="/auth/login" method="POST" id="loginForm">
                <div class="form-group-custom">
                    <label for="loginEmail">Email Address or Matric Number</label>
                    <div class="input-icon-wrapper">
                        <i class="bi bi-person input-icon"></i>
                        <input type="text" id="loginEmail" name="email" class="form-control-custom" placeholder="Enter email or matric number" required value="<%= typeof email !== 'undefined' ? email : '' %>">
                    </div>
                </div>

                <div class="form-group-custom">
                    <label for="loginPassword">Password</label>
                    <div class="input-icon-wrapper">
                        <i class="bi bi-lock input-icon"></i>
                        <input type="password" id="loginPassword" name="password" class="form-control-custom" placeholder="Enter your password" required>
                        <button type="button" class="input-icon-right" id="togglePassword" aria-label="Toggle password visibility">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="form-options">
                    <div class="form-check-custom">
                        <input type="checkbox" id="rememberMe" name="remember">
                        <label for="rememberMe">Remember me</label>
                    </div>
                    <a href="/auth/forgot-password" class="forgot-link">Forgot Password?</a>
                </div>

                <button type="submit" class="btn-custom btn-primary-custom btn-auth">
                    <i class="bi bi-box-arrow-in-right"></i> Sign In
                </button>
            </form>
        </div>

        <div class="auth-footer">
            Student without an account? <a href="/auth/register">Register here</a>
        </div>

        <div class="auth-back-link">
            <a href="/"><i class="bi bi-arrow-left"></i> Back to Home</a>
        </div>
    </div>
</div>
