<!-- Dashboard Sidebar -->
<aside class="dashboard-sidebar" id="dashboardSidebar">
    <div class="sidebar-header">
        <a href="/" class="sidebar-brand">
            <div class="sidebar-brand-icon">
                <i class="bi bi-qr-code-scan"></i>
            </div>
            <div class="sidebar-brand-text">
                QR Attendance
                <small>Management System</small>
            </div>
        </a>
    </div>

    <nav class="sidebar-nav">
        <% if (user && user.role === 'student') { %>
            <!-- Student Navigation -->
            <div class="sidebar-nav-section">
                <div class="sidebar-nav-label">Main Menu</div>
                <ul class="sidebar-nav-items">
                    <li class="sidebar-nav-item">
                        <a href="/student/dashboard" class="<%= currentPath === '/student/dashboard' ? 'active' : '' %>">
                            <i class="bi bi-speedometer2"></i> Dashboard
                        </a>
                    </li>
                    <li class="sidebar-nav-item">
                        <a href="/student/qrcode" class="<%= currentPath.startsWith('/student/qrcode') ? 'active' : '' %>">
                            <i class="bi bi-camera"></i> Scan Exam QR
                        </a>
                    </li>
                    <li class="sidebar-nav-item">
                        <a href="/student/attendance" class="<%= currentPath.startsWith('/student/attendance') ? 'active' : '' %>">
                            <i class="bi bi-calendar-check"></i> Attendance History
                        </a>
                    </li>
                </ul>
            </div>
            <div class="sidebar-nav-section">
                <div class="sidebar-nav-label">Account</div>
                <ul class="sidebar-nav-items">
                    <li class="sidebar-nav-item">
                        <a href="/student/profile" class="<%= currentPath.startsWith('/student/profile') ? 'active' : '' %>">
                            <i class="bi bi-person"></i> Profile
                        </a>
                    </li>
                </ul>
            </div>

        <% } else if (user && user.role === 'lecturer') { %>
            <!-- Lecturer Navigation -->
            <div class="sidebar-nav-section">
                <div class="sidebar-nav-label">Main Menu</div>
                <ul class="sidebar-nav-items">
                    <li class="sidebar-nav-item">
                        <a href="/lecturer/dashboard" class="<%= currentPath === '/lecturer/dashboard' ? 'active' : '' %>">
                            <i class="bi bi-speedometer2"></i> Dashboard
                        </a>
                    </li>
                    <li class="sidebar-nav-item">
                        <a href="/lecturer/scanner" class="<%= currentPath.startsWith('/lecturer/scanner') ? 'active' : '' %>">
                            <i class="bi bi-camera"></i> Scan Attendance
                        </a>
                    </li>
                    <li class="sidebar-nav-item">
                        <a href="/lecturer/attendance" class="<%= currentPath.startsWith('/lecturer/attendance') ? 'active' : '' %>">
                            <i class="bi bi-clipboard-data"></i> Attendance Records
                        </a>
                    </li>
                </ul>
            </div>
            <div class="sidebar-nav-section">
                <div class="sidebar-nav-label">Management</div>
                <ul class="sidebar-nav-items">
                    <li class="sidebar-nav-item">
                        <a href="/lecturer/students" class="<%= currentPath.startsWith('/lecturer/students') ? 'active' : '' %>">
                            <i class="bi bi-mortarboard"></i> Students
                        </a>
                    </li>
                    <li class="sidebar-nav-item">
                        <a href="/lecturer/examinations" class="<%= currentPath.startsWith('/lecturer/examinations') ? 'active' : '' %>">
                            <i class="bi bi-journal-text"></i> Examinations
                        </a>
                    </li>
                </ul>
            </div>
            <div class="sidebar-nav-section">
                <div class="sidebar-nav-label">Analytics</div>
                <ul class="sidebar-nav-items">
                    <li class="sidebar-nav-item">
                        <a href="/lecturer/reports" class="<%= currentPath.startsWith('/lecturer/reports') ? 'active' : '' %>">
                            <i class="bi bi-bar-chart-line"></i> Reports
                        </a>
                    </li>
                </ul>
            </div>
            <div class="sidebar-nav-section">
                <div class="sidebar-nav-label">Account</div>
                <ul class="sidebar-nav-items">
                    <li class="sidebar-nav-item">
                        <a href="/lecturer/profile" class="<%= currentPath.startsWith('/lecturer/profile') ? 'active' : '' %>">
                            <i class="bi bi-person"></i> Profile
                        </a>
                    </li>
                </ul>
            </div>

        <% } else if (user && user.role === 'admin') { %>
            <!-- Admin Navigation -->
            <div class="sidebar-nav-section">
                <div class="sidebar-nav-label">Main Menu</div>
                <ul class="sidebar-nav-items">
                    <li class="sidebar-nav-item">
                        <a href="/admin/dashboard" class="<%= currentPath === '/admin/dashboard' ? 'active' : '' %>">
                            <i class="bi bi-speedometer2"></i> Dashboard
                        </a>
                    </li>
                </ul>
            </div>
            <div class="sidebar-nav-section">
                <div class="sidebar-nav-label">Management</div>
                <ul class="sidebar-nav-items">
                    <li class="sidebar-nav-item">
                        <a href="/admin/students" class="<%= currentPath.startsWith('/admin/students') ? 'active' : '' %>">
                            <i class="bi bi-mortarboard"></i> Students
                        </a>
                    </li>
                    <li class="sidebar-nav-item">
                        <a href="/admin/lecturers" class="<%= currentPath.startsWith('/admin/lecturers') ? 'active' : '' %>">
                            <i class="bi bi-person-workspace"></i> Lecturers
                        </a>
                    </li>
                    <li class="sidebar-nav-item">
                        <a href="/admin/examinations" class="<%= currentPath.startsWith('/admin/examinations') ? 'active' : '' %>">
                            <i class="bi bi-journal-text"></i> Examinations
                        </a>
                    </li>
                </ul>
            </div>
            <div class="sidebar-nav-section">
                <div class="sidebar-nav-label">Analytics</div>
                <ul class="sidebar-nav-items">
                    <li class="sidebar-nav-item">
                        <a href="/admin/attendance-reports" class="<%= currentPath.startsWith('/admin/attendance-reports') ? 'active' : '' %>">
                            <i class="bi bi-graph-up"></i> Attendance Reports
                        </a>
                    </li>
                </ul>
            </div>
            <div class="sidebar-nav-section">
                <div class="sidebar-nav-label">System</div>
                <ul class="sidebar-nav-items">
                    <li class="sidebar-nav-item">
                        <a href="/admin/settings" class="<%= currentPath.startsWith('/admin/settings') ? 'active' : '' %>">
                            <i class="bi bi-gear"></i> Settings
                        </a>
                    </li>
                </ul>
            </div>
            <div class="sidebar-nav-section">
                <div class="sidebar-nav-label">Account</div>
                <ul class="sidebar-nav-items">
                    <li class="sidebar-nav-item">
                        <a href="/admin/profile" class="<%= currentPath.startsWith('/admin/profile') ? 'active' : '' %>">
                            <i class="bi bi-person"></i> Profile
                        </a>
                    </li>
                </ul>
            </div>
        <% } %>
    </nav>

    <div class="sidebar-footer">
        <div class="sidebar-user">
            <div class="sidebar-user-avatar">
                <% if (user && user.passport_url) { %>
                    <img src="/uploads/<%= user.passport_url %>" alt="<%= user.first_name %>">
                <% } else { %>
                    <%= user ? user.first_name.charAt(0).toUpperCase() : 'U' %>
                <% } %>
            </div>
            <div class="sidebar-user-info">
                <div class="sidebar-user-name"><%= user ? user.first_name + ' ' + user.last_name : 'User' %></div>
                <div class="sidebar-user-role"><%= user ? user.role : '' %></div>
            </div>
            <a href="/auth/logout" class="sidebar-logout-btn" title="Logout">
                <i class="bi bi-box-arrow-right"></i>
            </a>
        </div>
    </div>
</aside>
